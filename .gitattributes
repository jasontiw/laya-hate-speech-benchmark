# Normalise line endings in the repository so clones on any OS behave the same.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

*.png  binary
*.jpg  binary
*.pdf  binary
*.safetensors binary
*.bin  binary
